{
  "framework": null,
  "buildCommand": "npm run build:js",
  "outputDirectory": "dist",
  "functions": {
    "api/invitation.js": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/invitation" },
    { "source": "/index.html", "destination": "/api/invitation" }
  ]
}
